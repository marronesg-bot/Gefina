{
    "compilerOptions": {
        "target": "esnext", //esnest é para versao mais recente
        "lib": ["ESNext", "DOM"],
        "module": "esnext", // modulo de forma mais moderna
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "erasableSyntaxOnly": true,
        "allowArbitraryExtensions": true,
        "noEmit": true
    },

    "include": ["src"] //somente o que estiver dentro do src
}